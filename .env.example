# --- Zulip bot credentials (Personal settings > Bots > Add a new bot, type "Generic bot") ---
ZULIP_SITE=https://your-org.zulipchat.com
ZULIP_EMAIL=claude-bot@your-org.zulipchat.com
ZULIP_API_KEY=

# --- Claude: pick ONE way to authenticate, and leave the others commented out ---
# (an empty ANTHROPIC_API_KEY= line still counts as set and blocks the other two)
# 1. API key
# ANTHROPIC_API_KEY=sk-ant-...
# 2. Locally: nothing here, just run `ant auth login` once
# 3. Workload identity federation (e.g. on AWS)
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_SERVICE_ACCOUNT_ID=
# ANTHROPIC_IDENTITY_TOKEN_FILE=/path/to/jwt
# ANTHROPIC_WORKSPACE_ID=        # only if the rule spans several workspaces
# CLAUDE_MODEL=claude-opus-5-5
# AGENT_EFFORT=high         # low | medium | high | xhigh | max
# CONSOLE_WORKSPACE=default # workspace ID for the trace links, if your key isn't in the Default workspace

# --- GitHub (fine-grained token: Contents + Pull requests read/write on the repos) ---
GH_TOKEN=

# --- Which repo each channel works on (JSON: channel name -> owner/name) ---
ZULIP_CLAUDE_REPOS={"engineering": "your-org/backend", "web": "your-org/frontend"}
# Repo for DMs and unmapped channels. Empty = the agent gets an empty sandbox.
DEFAULT_REPO=

# --- Agent sandbox ---
# AGENT_NETWORK=limited     # limited (package registries + GitHub) | unrestricted
# AGENT_WEB=false           # let the agent search and fetch web pages
# SESSION_BUDGET_USD=20     # hard spend cap per topic's agent session
# AGENT_TIMEOUT_SECONDS=3600

# --- Access ---
# Comma-separated emails or Zulip user ids. Empty = anyone who can mention the bot.
ALLOWED_USERS=
# MAX_CONCURRENT_RUNS=3
# CONTEXT_MESSAGES=50
# LOG_LEVEL=INFO
